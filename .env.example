# Copie este arquivo para ".env" e ajuste os valores locais.

# Caminho do banco SQLite (relativo à raiz do projeto)
DB_NAME=datasets/censo_escolar.db

# Arquivos JSON usados na carga inicial do banco (relativos à raiz do projeto)
CAMINHO_JSON_INSTITUICOES=datasets/escolas_pb_matriculas_2025.json
CAMINHO_JSON_USUARIOS=datasets/usuarios.json

# Servidor Flask
FLASK_DEBUG=false
FLASK_PORT=5000

# Maior valor aceito no parâmetro "limit" da paginação
LIMIT_MAXIMO_PAGINA=1000
